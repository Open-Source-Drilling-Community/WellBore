@implements IUnitAwareComponent
@inject ILogger<WellBoreEdit> logger
@inject ISnackbar Snackbar
@inject IWellBoreAPIUtils Api

<MudText Class="mt-4 mb-4" Typo="Typo.h6">Edit WellBore</MudText>
<MudContainer Class="d-flex flex-row mt-4 mb-4">
    <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Success" OnClick="Update">Update</MudButton>
    <MudButton Class="me-1" Variant="Variant.Filled" OnClick="Cancel">Cancel</MudButton>
</MudContainer>

<MudGrid>
    <MudItem xs="12" sm="4" md="4" lg="4" xl="4">
        <MudTextField @bind-Value="@name" Label="Name" Variant="Variant.Filled"></MudTextField>
    </MudItem>
    <MudItem xs="12" sm="8" md="8" lg="8" xl="8">
        <MudTextField @bind-Value="@descr" Label="Description" Variant="Variant.Filled"></MudTextField>
    </MudItem>

    @if (Fields != null)
    {
        <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
            <MudSelect Label="Field" @bind-Value="@_selectedField" Dense="true" ToStringFunc="@(s => s?.Name)">
                @foreach (var field in Fields.Where(x => string.IsNullOrEmpty(_fieldSearchText) || (x != null && !string.IsNullOrEmpty(x.Name) && x.Name.Contains(_fieldSearchText, StringComparison.OrdinalIgnoreCase))))
                {
                    <MudSelectItem Value="@field">@field.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
            <MudTextField @bind-Value="@_fieldSearchText" Label="Filter Fields"></MudTextField>
        </MudItem>
    }
    @if (Clusters != null && _selectedField != null)
    {
        <MudItem xs="10" sm="4" md="4" lg="4" xl="4">
            <MudSwitch @bind-Value="@_useSingleWells" Color="Color.Primary">Use Single Wells</MudSwitch>
        </MudItem>
        <MudItem xs="2" sm="4" md="8" lg="8" xl="8">
        </MudItem>
        if (!_useSingleWells)
        {
            <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
                <MudSelect Label="Cluster" @bind-Value="@selectedCluster" Dense="true" ToStringFunc="@(s => s?.Name)">
                    @foreach (var cluster in Clusters.Where(x =>
                                (x != null && x.FieldID != null && _selectedField != null && _selectedField.MetaInfo != null && _selectedField.MetaInfo.ID == x.FieldID && !x.IsSingleWell) &&
                                (string.IsNullOrEmpty(_clusterSearchText) || (x != null && !string.IsNullOrEmpty(x.Name) && x.Name.Contains(_clusterSearchText, StringComparison.OrdinalIgnoreCase)))))
                    {
                        <MudSelectItem Value="@cluster">@cluster.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
                <MudTextField @bind-Value="@_clusterSearchText" Label="Filter Clusters"></MudTextField>
            </MudItem>
        }
    }
    @if (Wells != null && (selectedCluster != null || _useSingleWells))
    {
        <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
            <MudSelect Label="Well" @bind-Value="@_selectedWell" Dense="true" ToStringFunc="@(s => s?.Name)">
                @foreach (var well in Wells.Where(x =>
                            (x != null && x.ClusterID != null && 
                            ((!_useSingleWells && selectedCluster != null && selectedCluster.MetaInfo != null && selectedCluster.MetaInfo.ID == x.ClusterID) || 
                             (_useSingleWells && x.IsSingleWell))) &&
                            (string.IsNullOrEmpty(_wellSearchText) || (x != null && !string.IsNullOrEmpty(x.Name) && x.Name.Contains(_wellSearchText, StringComparison.OrdinalIgnoreCase)))))
                {
                    <MudSelectItem Value="@well">@well.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
            <MudTextField @bind-Value="@_wellSearchText" Label="Filter Wells"></MudTextField>
        </MudItem>
    }
    @if (_selectedWell != null)
    {
        <MudItem xs="10" sm="4" md="4" lg="4" xl="4">
            <MudSwitch @bind-Value="@_isSidetrack" Color="Color.Primary">Is Sidetrack</MudSwitch>
        </MudItem>
        <MudItem xs="2" sm="4" md="8" lg="8" xl="8">
        </MudItem>
        @if (_isSidetrack && WellBores != null && CurrentWellBore != null && CurrentWellBore.MetaInfo != null && CurrentWellBore.MetaInfo.ID != Guid.Empty)
        {
            <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
                <MudSelect Label="Wellbore" @bind-Value="@_selectedParentWellBore" Dense="true" ToStringFunc="@(s => s?.Name)">
                    @foreach (var wellBore in WellBores.Where(x =>
                                (x != null && x.WellID != null && _selectedWell != null && _selectedWell.MetaInfo != null && _selectedWell.MetaInfo.ID == x.WellID && x.MetaInfo != null && x.MetaInfo.ID != CurrentWellBore.MetaInfo.ID) &&
                                (string.IsNullOrEmpty(_wellBoreSearchText) || (x != null && !string.IsNullOrEmpty(x.Name) && x.Name.Contains(_wellBoreSearchText, StringComparison.OrdinalIgnoreCase)))))
                    {
                        <MudSelectItem Value="@wellBore">@wellBore.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="6" lg="6" xl="6">
                <MudTextField @bind-Value="@_wellBoreSearchText" Label="Filter Wellbores"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="4" md="4" lg="4">
                <MudInputWithUnitAdornment QuantityName="DepthDrilling"
                                           QuantityLabel="Sidetrack Along Hole Depth"
                                           DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                           SIValueNullable="_sidetrackDepth"
                                           SIValueNullableChanged="(val => _sidetrackDepth = val)" />
            </MudItem>
            <MudItem xs="12" sm="4" md="4" lg="4">
                <MudInputWithUnitAdornment QuantityName="LengthSmall"
                                           QuantityLabel="Sidetrack Along Hole Depth Accuracy"
                                           SIValueNullable="_sidetrackDepthAccuracy"
                                           SIValueNullableChanged="@(val => _sidetrackDepthAccuracy = val)" />

            </MudItem>
            <MudItem xs="12" sm="4" md="4" lg="4" xl="4">
                <MudSelect T="Guid?" Label="Sidetrack Classification" @bind-Value="@_sidetrackClassificationOptionId" Dense="true" Clearable="true">
                    @foreach (WellBoreFeatureOption option in SidetrackClassificationOptions())
                    {
                        <MudSelectItem T="Guid?" Value="option.ID">@option.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
    }
</MudGrid>

<MudExpansionPanels MultiExpansion="true" Class="mt-4">
    <MudExpansionPanel Text="Identities">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" Label="Identity" @bind-Value="_selectedIdentityId">
                    @foreach (WellBoreIdentity identity in _wellBoreIdentities.Where(item => item.MetaInfo?.ID != null))
                    {
                        <MudSelectItem T="Guid?" Value="identity.MetaInfo!.ID">@identity.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="AssignIdentity">Assign</MudButton>
            </MudItem>
            <MudItem xs="12">
                @foreach (WellBoreIdentityAssignment assignment in _wellBoreIdentityAssignments)
                {
                    <MudGrid Class="mb-2" @key="assignment.ID">
                        <MudItem xs="12" md="4"><MudTextField Value="@GetIdentityName(assignment)" ReadOnly="true" /></MudItem>
                        <MudItem xs="10" md="7"><MudTextField @bind-Value="assignment.Value" Label="Value" Required="true" /></MudItem>
                        <MudItem xs="2" md="1"><MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => _wellBoreIdentityAssignments.Remove(assignment))" /></MudItem>
                    </MudGrid>
                }
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Features">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" Label="Category" Value="_selectedFeatureCategoryId" ValueChanged="SelectFeatureCategory">
                    @foreach (WellBoreFeatureCategory category in _wellBoreFeatureCategories.Where(item => item.MetaInfo?.ID != null && item.Name != SidetrackClassificationCategoryName))
                    {
                        <MudSelectItem T="Guid?" Value="category.MetaInfo!.ID">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" Label="Option" @bind-Value="_selectedFeatureOptionId">
                    @foreach (WellBoreFeatureOption option in SelectedFeatureOptions())
                    {
                        <MudSelectItem T="Guid?" Value="option.ID">@option.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="AssignFeature">Assign</MudButton>
            </MudItem>
            <MudItem xs="12">
                @foreach (WellBoreFeatureAssignment assignment in _wellBoreFeatureAssignments.Where(item => !IsSidetrackClassification(item)))
                {
                    <MudGrid Class="mb-2" @key="assignment.ID">
                        <MudItem xs="12" md="4"><MudTextField Value="@GetFeatureName(assignment)" ReadOnly="true" /></MudItem>
                        <MudItem xs="5" md="3"><MudDatePicker Label="From" Date="@ToDateTime(assignment.FromDate)" DateChanged="@((DateTime? value) => assignment.FromDate = ToDateTimeOffset(value))" Disabled="@(!FeatureHasValidityPeriod(assignment))" Clearable="true" /></MudItem>
                        <MudItem xs="5" md="3"><MudDatePicker Label="To" Date="@ToDateTime(assignment.ToDate)" DateChanged="@((DateTime? value) => assignment.ToDate = ToDateTimeOffset(value))" Disabled="@(!FeatureHasValidityPeriod(assignment))" Clearable="true" /></MudItem>
                        <MudItem xs="2" md="1"><MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => _wellBoreFeatureAssignments.Remove(assignment))" /></MudItem>
                    </MudGrid>
                }
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [CascadingParameter]
    private MudUnitAndReferenceChoiceTag? Parent { get; set; }

    [Parameter]
    public WellBore? CurrentWellBore { get; set; }

    [Parameter]
    public List<Field>? Fields { get; set; }

    [Parameter]
    public List<Cluster>? Clusters { get; set; }

    [Parameter]
    public List<Well>? Wells { get; set; }

    [Parameter]
    public List<WellBore>? WellBores { get; set; }

    [Parameter]
    public List<Rig>? Rigs { get; set; }

    [Parameter]
    public GroundMudLineDepthReferenceSource? GroundMudLineDepthSource { get; set; }

    [Parameter]
    public SeaWaterLevelDepthReferenceSource? TopWaterDepthSource { get; set; }

    [Parameter]
    public MeanSeaLevelDepthReferenceSource? MeanSeaLevelDepthSource { get; set; }

    [Parameter]
    public WellHeadDepthReferenceSource? WellHeadDepthSource { get; set; }

    [Parameter]
    public RotaryTableDepthReferenceSource? RotaryTableDepthSource { get; set; }

    [Parameter]
    public Action? OnUpdate { get; set; }

    // Local variables used to retrieve user-defined parameters
    private string? name;
    private string? descr;

    // Labels
    private string? inputParamUnitLabel = null;

    // UI related variables
    private string? _wellBoreSearchString;
    private Field? _selectedField = null;
    private Cluster? _selectedCluster = null;
    private Cluster? selectedCluster { get { return _selectedCluster; } set { _selectedCluster = value; _ = ProcessSelectedClusterAsync(); } }
    private Well? _selectedWell = null;
    private WellBore? _selectedParentWellBore = null;
    private string? _fieldSearchText = null;
    private bool _useSingleWells = false;
    private string? _clusterSearchText = null;
    private string? _wellSearchText = null;
    private string? _wellBoreSearchText = null;
    private bool _isSidetrack = false;
    private double? _sidetrackDepth = null;
    private double? _sidetrackDepthAccuracy = null;
    private const string SidetrackClassificationCategoryName = "SidetrackClassification";
    private Guid? _sidetrackClassificationOptionId;
    private List<WellBoreIdentity> _wellBoreIdentities = [];
    private List<WellBoreIdentityAssignment> _wellBoreIdentityAssignments = [];
    private Guid? _selectedIdentityId;
    private List<WellBoreFeatureCategory> _wellBoreFeatureCategories = [];
    private List<WellBoreFeatureAssignment> _wellBoreFeatureAssignments = [];
    private Guid? _selectedFeatureCategoryId;
    private Guid? _selectedFeatureOptionId;

    private async Task ProcessSelectedClusterAsync()
    {
        if (_selectedCluster == null)
        {
            if (GroundMudLineDepthSource != null)
            {
                GroundMudLineDepthSource.GroundMudLineDepthReference = null;
            }
            if (TopWaterDepthSource != null)
            {
                TopWaterDepthSource.SeaWaterLevelDepthReference = null;
            }
            if (MeanSeaLevelDepthSource != null)
            {
                MeanSeaLevelDepthSource.MeanSeaLevelDepthReference = null;
            }
            if (WellHeadDepthSource != null)
            {
                WellHeadDepthSource.WellHeadDepthReference = null;
            }
            if (RotaryTableDepthSource != null)
            {
                RotaryTableDepthSource.RotaryTableDepthReference = null;
            }
        }
        else
        {
            if (GroundMudLineDepthSource != null && _selectedCluster.GroundMudLineDepth != null && _selectedCluster.GroundMudLineDepth.GaussianValue != null)
            {
                GroundMudLineDepthSource.GroundMudLineDepthReference = -_selectedCluster.GroundMudLineDepth.GaussianValue.Mean;
            }
            if (TopWaterDepthSource != null && _selectedCluster.TopWaterDepth != null && _selectedCluster.TopWaterDepth.GaussianValue != null)
            {
                TopWaterDepthSource.SeaWaterLevelDepthReference = -_selectedCluster.TopWaterDepth.GaussianValue.Mean;
            }
            if (MeanSeaLevelDepthSource != null)
            {
                MeanSeaLevelDepthSource.MeanSeaLevelDepthReference = await ResolveMeanSeaLevelDepthReferenceAsync();
            }
            if (WellHeadDepthSource != null && _selectedCluster.ReferenceDepth != null && _selectedCluster.ReferenceDepth.GaussianValue != null)
            {
                WellHeadDepthSource.WellHeadDepthReference = -_selectedCluster.ReferenceDepth.GaussianValue.Mean;
            }
            if (RotaryTableDepthSource != null)
            {
                RotaryTableDepthSource.RotaryTableDepthReference = ResolveRotaryTableReference(_selectedCluster, CurrentWellBore);
            }
        }
    }

    private async Task<double?> ResolveMeanSeaLevelDepthReferenceAsync()
    {
        try
        {
            WellBore? referenceWellBore = null;
            if (_selectedWell?.MetaInfo?.ID is Guid wellId)
            {
                referenceWellBore = new WellBore()
                {
                    MetaInfo = CurrentWellBore?.MetaInfo,
                    Name = CurrentWellBore?.Name,
                    Description = CurrentWellBore?.Description,
                    WellID = wellId,
                    IsSidetrack = _isSidetrack,
                    ParentWellBoreID = _selectedParentWellBore?.MetaInfo?.ID
                };
            }

            return await DepthReferenceUtils.ResolveMeanSeaLevelDepthReferenceAsync(Api, referenceWellBore, WellBores, Wells, Clusters);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to resolve MSL depth reference for selected wellbore");
            return null;
        }
    }

    private double? ResolveRotaryTableReference(Cluster? cluster, WellBore? wellBore)
    {
        Guid? rigId = cluster?.RigID;
        if (rigId == null || rigId == Guid.Empty)
        {
            rigId = wellBore?.RigID;
        }

        if (rigId is not Guid resolvedRigId || Rigs == null)
        {
            return null;
        }

        return Rigs.FirstOrDefault(rig => rig?.MetaInfo?.ID == resolvedRigId)?.DrillFloorElevation is double drillFloorElevation
            ? -drillFloorElevation
            : null;
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Parent == null)
                throw new ArgumentNullException(nameof(Parent), "TargetEdit page must exist within a MudUnitAndReferenceChoiceTag");
            Parent.Add(this);
            ManageUnits();

            _wellBoreIdentities = await LoadWellBoreIdentitiesAsync();
            _wellBoreFeatureCategories = await LoadWellBoreFeatureCategoriesAsync();

            if (CurrentWellBore != null && CurrentWellBore.MetaInfo != null)
            {
                name = CurrentWellBore.Name;
                descr = CurrentWellBore.Description;
                _wellBoreIdentityAssignments = CloneIdentityAssignments(CurrentWellBore.WellBoreIdentityAssignments);
                _wellBoreFeatureAssignments = CloneFeatureAssignments(CurrentWellBore.WellBoreFeatureAssignments);
                _isSidetrack = CurrentWellBore.IsSidetrack;
                if (_isSidetrack && WellBores != null && CurrentWellBore.ParentWellBoreID != null && CurrentWellBore.ParentWellBoreID != Guid.Empty)
                {
                    foreach (var wellbore in WellBores)
                    {
                        if (wellbore != null && wellbore.MetaInfo != null && wellbore.MetaInfo.ID == CurrentWellBore.ParentWellBoreID)
                        {
                            _selectedParentWellBore = wellbore;
                            break;
                        }
                    }
                }
                if (_isSidetrack)
                {
                    WellBoreFeatureCategory? classification = SidetrackClassificationCategory();
                    WellBoreFeatureAssignment? classificationAssignment = _wellBoreFeatureAssignments
                        .FirstOrDefault(item => item.FeatureCategoryID == classification?.MetaInfo?.ID);
                    _sidetrackClassificationOptionId = classificationAssignment?.FeatureOptionID ?? classification?.Options?
                        .FirstOrDefault(option => string.Equals(option.Name, CurrentWellBore.SidetrackType.ToString(), StringComparison.OrdinalIgnoreCase))?.ID;
                    if (CurrentWellBore.TieInPointAlongHoleDepth != null && CurrentWellBore.TieInPointAlongHoleDepth.GaussianValue != null)
                    {
                        _sidetrackDepth = CurrentWellBore.TieInPointAlongHoleDepth.GaussianValue.Mean;
                        _sidetrackDepthAccuracy = CurrentWellBore.TieInPointAlongHoleDepth.GaussianValue.StandardDeviation;
                    }
                }
                if (Wells != null && CurrentWellBore.WellID != Guid.Empty)
                {
                    foreach (var well in Wells)
                    {
                        if (well != null && well.MetaInfo != null && well.MetaInfo.ID == CurrentWellBore.WellID)
                        {
                            _selectedWell = well;
                            break;
                        }
                    }
                }
                if (_selectedWell != null)
                {
                    _useSingleWells = _selectedWell.IsSingleWell;
                }
                if (Clusters != null && _selectedWell != null && _selectedWell.ClusterID != Guid.Empty)
                {
                    foreach (var cluster in Clusters)
                    {
                        if (cluster != null && cluster.MetaInfo != null && cluster.MetaInfo.ID == _selectedWell.ClusterID)
                        {
                            _selectedCluster = cluster;
                            await ProcessSelectedClusterAsync();
                            break;
                        }
                    }
                }
                if (Fields != null && selectedCluster != null && selectedCluster.FieldID != Guid.Empty)
                {
                    foreach (var field in Fields)
                    {
                        if (field != null && field.MetaInfo != null && field.MetaInfo.ID == selectedCluster.FieldID)
                        {
                            _selectedField = field;
                            break;
                        }
                    }
                }
            }
            else
            {
                logger.LogError("Current WellBore is null or badly formed");
                Snackbar.Add("Current WellBore is null or badly formed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem on WellBore initialization");
            Snackbar.Add("Problem on WellBore initialization", Severity.Error);
        }
        await InvokeAsync(() => { StateHasChanged(); });
    }

    public void ManageUnits()
    {

    }

    private async Task Update()
    {
        if (!ValidateCatalogAssignments())
        {
            return;
        }
        try
        {
            if (CurrentWellBore != null && CurrentWellBore.MetaInfo != null)
            {
                ApplySidetrackClassification();
                WellBore wellBore = new()
                {
                    MetaInfo = CurrentWellBore.MetaInfo,
                    Name = name,
                    Description = descr,
                    CreationDate = CurrentWellBore.CreationDate,
                    LastModificationDate = DateTimeOffset.UtcNow,
                    IsSidetrack = _isSidetrack,
                    RigID = CurrentWellBore.RigID,
                    WellBoreIdentityAssignments = CloneIdentityAssignments(_wellBoreIdentityAssignments),
                    WellBoreFeatureAssignments = CloneFeatureAssignments(_wellBoreFeatureAssignments),
                };
                if (_selectedWell != null && _selectedWell.MetaInfo != null && _selectedWell.MetaInfo.ID != Guid.Empty)
                {
                    wellBore.WellID = _selectedWell.MetaInfo.ID;
                }
                if (_isSidetrack && _selectedParentWellBore != null && _selectedParentWellBore.MetaInfo != null && _selectedParentWellBore.MetaInfo.ID != Guid.Empty)
                {
                    wellBore.ParentWellBoreID = _selectedParentWellBore.MetaInfo.ID;
                }
                if (_isSidetrack)
                {
                    if (_sidetrackDepth != null)
                    {
                        wellBore.TieInPointAlongHoleDepth = new GaussianDrillingProperty() { GaussianValue = new GaussianDistribution() { Mean = _sidetrackDepth, StandardDeviation = (_sidetrackDepthAccuracy == null) ? 0.01 : _sidetrackDepthAccuracy } };
                    }
                }
                if (CurrentWellBore.LastModificationDate is not DateTimeOffset expectedModifiedUtc)
                {
                    Snackbar.Add("Reload the WellBore before updating it because its revision is unavailable.", Severity.Warning);
                    return;
                }
                await Api.ClientWellBore.PutWellBoreByIdAsync(CurrentWellBore.MetaInfo.ID, expectedModifiedUtc, wellBore);
                logger.LogInformation("Updated the WellBore successfully");
                Snackbar.Add("Updated the WellBore successfully", Severity.Success);
            }
            else
            {
                logger.LogWarning("Problem while updating the WellBore");
                Snackbar.Add("Problem while updating the WellBore", Severity.Warning);
            }
        }
        catch (ApiException ex)
        {
            logger.LogError(ex, "Problem while updating the WellBore");
            Snackbar.Add("Problem while updating the WellBore", Severity.Warning);
        }
        OnUpdate?.Invoke();
    }

    private void Cancel()
    {
        OnUpdate?.Invoke();
    }

    private void AssignIdentity()
    {
        if (_selectedIdentityId is not Guid identityId || identityId == Guid.Empty ||
            _wellBoreIdentityAssignments.Any(item => item.IdentityID == identityId)) return;
        _wellBoreIdentityAssignments.Add(new WellBoreIdentityAssignment { ID = Guid.NewGuid(), IdentityID = identityId });
    }

    private async Task<List<WellBoreIdentity>> LoadWellBoreIdentitiesAsync()
    {
        try
        {
            return ((IEnumerable<WellBoreIdentity>)await Api.ClientWellBore.GetAllWellBoreIdentityAsync())
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (ApiException exception) when (exception.StatusCode == 404)
        {
            logger.LogWarning("The WellBore service does not yet expose the identity catalog endpoint");
            Snackbar.Add("WellBore identities will be available after the service is upgraded", Severity.Info);
            return [];
        }
    }

    private async Task<List<WellBoreFeatureCategory>> LoadWellBoreFeatureCategoriesAsync()
    {
        try
        {
            return ((IEnumerable<WellBoreFeatureCategory>)await Api.ClientWellBore.GetAllWellBoreFeatureCategoryAsync())
                .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (ApiException exception) when (exception.StatusCode == 404)
        {
            logger.LogWarning("The WellBore service does not yet expose the feature catalog endpoint");
            Snackbar.Add("WellBore features will be available after the service is upgraded", Severity.Info);
            return [];
        }
    }

    private string GetIdentityName(WellBoreIdentityAssignment assignment) =>
        _wellBoreIdentities.FirstOrDefault(item => item.MetaInfo?.ID == assignment.IdentityID)?.Name ?? "Unknown identity";

    private void SelectFeatureCategory(Guid? categoryId)
    {
        _selectedFeatureCategoryId = categoryId;
        _selectedFeatureOptionId = null;
    }

    private IEnumerable<WellBoreFeatureOption> SelectedFeatureOptions() =>
        _wellBoreFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == _selectedFeatureCategoryId)?.Options ?? [];

    private void AssignFeature()
    {
        if (_selectedFeatureCategoryId is not Guid categoryId || _selectedFeatureOptionId is not Guid optionId) return;
        WellBoreFeatureCategory? category = _wellBoreFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == categoryId);
        if (category == null || category.Options?.Any(item => item.ID == optionId) != true) return;
        if (category.IsExclusive && !category.HasValidityPeriod &&
            _wellBoreFeatureAssignments.Any(item => item.FeatureCategoryID == categoryId))
        {
            Snackbar.Add($"Only one '{category.Name}' assignment is allowed at a time", Severity.Warning);
            return;
        }
        _wellBoreFeatureAssignments.Add(new WellBoreFeatureAssignment
        {
            ID = Guid.NewGuid(), FeatureCategoryID = categoryId, FeatureOptionID = optionId
        });
    }

    private string GetFeatureName(WellBoreFeatureAssignment assignment)
    {
        WellBoreFeatureCategory? category = _wellBoreFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == assignment.FeatureCategoryID);
        WellBoreFeatureOption? option = category?.Options?.FirstOrDefault(item => item.ID == assignment.FeatureOptionID);
        return $"{category?.Name ?? "Unknown category"}: {option?.Name ?? "Unknown option"}";
    }

    private bool FeatureHasValidityPeriod(WellBoreFeatureAssignment assignment) =>
        _wellBoreFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == assignment.FeatureCategoryID)?.HasValidityPeriod == true;

    private WellBoreFeatureCategory? SidetrackClassificationCategory() =>
        _wellBoreFeatureCategories.FirstOrDefault(item => item.Name == SidetrackClassificationCategoryName);

    private IEnumerable<WellBoreFeatureOption> SidetrackClassificationOptions() =>
        SidetrackClassificationCategory()?.Options ?? [];

    private bool IsSidetrackClassification(WellBoreFeatureAssignment assignment) =>
        assignment.FeatureCategoryID == SidetrackClassificationCategory()?.MetaInfo?.ID;

    private void ApplySidetrackClassification()
    {
        WellBoreFeatureCategory? category = SidetrackClassificationCategory();
        if (category?.MetaInfo == null) return;
        List<WellBoreFeatureAssignment> existing = _wellBoreFeatureAssignments
            .Where(item => item.FeatureCategoryID == category.MetaInfo.ID).ToList();
        if (!_isSidetrack || _sidetrackClassificationOptionId is not Guid optionId ||
            category.Options?.Any(item => item.ID == optionId) != true)
        {
            _wellBoreFeatureAssignments.RemoveAll(item => item.FeatureCategoryID == category.MetaInfo.ID);
            return;
        }
        WellBoreFeatureAssignment? matching = existing.FirstOrDefault(item => item.FeatureOptionID == optionId);
        if (matching != null)
        {
            _wellBoreFeatureAssignments.RemoveAll(item => item.FeatureCategoryID == category.MetaInfo.ID && item.ID != matching.ID);
            return;
        }
        _wellBoreFeatureAssignments.RemoveAll(item => item.FeatureCategoryID == category.MetaInfo.ID);
        _wellBoreFeatureAssignments.Add(new WellBoreFeatureAssignment
        {
            ID = Guid.NewGuid(), FeatureCategoryID = category.MetaInfo.ID, FeatureOptionID = optionId
        });
    }

    private bool ValidateCatalogAssignments()
    {
        if (_wellBoreIdentityAssignments.Any(item => item.IdentityID == null || string.IsNullOrWhiteSpace(item.Value)))
        {
            Snackbar.Add("Every identity assignment requires an identity and value", Severity.Warning);
            return false;
        }
        if (_wellBoreFeatureAssignments.Any(item => item.FeatureCategoryID == null || item.FeatureOptionID == null ||
            (item.FromDate != null && item.ToDate != null && item.FromDate > item.ToDate)))
        {
            Snackbar.Add("Feature assignments require a valid category, option, and date range", Severity.Warning);
            return false;
        }
        return true;
    }

    private static List<WellBoreIdentityAssignment> CloneIdentityAssignments(IEnumerable<WellBoreIdentityAssignment>? values) =>
        values?.Select(item => new WellBoreIdentityAssignment { ID = item.ID, IdentityID = item.IdentityID, Value = item.Value }).ToList() ?? [];

    private static List<WellBoreFeatureAssignment> CloneFeatureAssignments(IEnumerable<WellBoreFeatureAssignment>? values) =>
        values?.Select(item => new WellBoreFeatureAssignment
        {
            ID = item.ID, FeatureCategoryID = item.FeatureCategoryID, FeatureOptionID = item.FeatureOptionID,
            FromDate = item.FromDate, ToDate = item.ToDate
        }).ToList() ?? [];

    private static DateTime? ToDateTime(DateTimeOffset? value) => value?.UtcDateTime;
    private static DateTimeOffset? ToDateTimeOffset(DateTime? value) => value == null ? null : new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc));

    //Quick filter - filter gobally across multiple columns with the same input
    private Func<WellBore, bool> _wellBoreFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_wellBoreSearchString))
            return true;
        if ($"{x.Name}".Contains(_wellBoreSearchString))
            return true;

        return false;
    };
}
